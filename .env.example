# Literal values only; no variable interpolation or shell commands.
# Resolve and record tested image digests before deployment.
# OtterIO: ghcr.io/soulteary/otterio:RELEASE.2026-10-09T15-22-07Z
# OC CLI / source-built console: RELEASE.2026-10-09T14-38-15Z
# Gitea: ghcr.io/go-gitea/gitea:28.1.0-rootless
TRAEFIK_IMAGE=CHANGE_ME
OTTERIO_IMAGE=CHANGE_ME
GITEA_IMAGE=CHANGE_ME
IMAGE_DOMAIN=img.example.com
DOWNLOAD_DOMAIN=files.example.com
S3_DOMAIN=s3.example.com
GIT_DOMAIN=git.example.com
ACME_EMAIL=admin@example.com
# http, alidns or cloudflare; secrets remain in secrets/.
TLS_MODE=http
# hosts: individual certificates; wildcard requires DNS-01.
TLS_CERT_MODE=hosts
# Set *.your-domain.tld only in wildcard mode; leave empty in hosts mode.
WILDCARD_DOMAIN=
UPLOAD_CIDRS=203.0.113.10/32
ADMIN_CIDRS=203.0.113.10/32
# Keep true until Gitea installation is locked and the admin account is secured.
GIT_BOOTSTRAP=true
# Fixed selection; renderer emits the correct override for TLS_MODE.
COMPOSE_FILE=compose.yaml:traefik/generated/compose.yaml
