{
  "entryPoints": {
    "web": {
      "address": ":8080",
      "http": {
        "redirections": {
          "entryPoint": {
            "to": ":443",
            "scheme": "https",
            "permanent": true
          }
        }
      }
    },
    "websecure": {
      "address": ":8443",
      "transport": {
        "respondingTimeouts": {
          "readTimeout": "300s",
          "writeTimeout": "300s",
          "idleTimeout": "180s"
        }
      },
      "http": {
        "tls": {
          "certResolver": "le"
        }
      }
    },
    "health": {
      "address": "127.0.0.1:8082"
    }
  },
  "providers": {
    "file": {
      "directory": "/etc/traefik/dynamic",
      "watch": true
    }
  },
  "certificatesResolvers": {
    "le": {
      "acme": {
        "email": "admin@test.net",
        "storage": "/acme/acme.json",
        "httpChallenge": {
          "entryPoint": "web"
        }
      }
    }
  },
  "api": {
    "dashboard": false
  },
  "log": {
    "level": "INFO"
  },
  "accessLog": {
    "format": "json",
    "fields": {
      "defaultMode": "drop",
      "names": {
        "StartUTC": "keep",
        "RequestHost": "keep",
        "RequestMethod": "keep",
        "DownstreamStatus": "keep",
        "DownstreamContentSize": "keep",
        "Duration": "keep",
        "OriginDuration": "keep",
        "RouterName": "keep",
        "ServiceName": "keep"
      },
      "headers": {
        "defaultMode": "drop"
      }
    }
  },
  "ping": {
    "entryPoint": "health"
  },
  "global": {
    "checkNewVersion": false,
    "sendAnonymousUsage": false
  }
}
